# Telegram Bot Token (BotFather se)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Database URL
# Local SQLite (default)
DATABASE_URL=sqlite:///data/database.sqlite3

# Railway / Postgres example:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Admin secret token (questions import/add ke liye)
ADMIN_TOKEN=CHANGE_THIS_TO_A_STRONG_SECRET

# Daily Quiz Time (24-hour format)
DAILY_QUIZ_HOUR=20
